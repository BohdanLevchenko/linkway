{
  "manifest_version": 3,
  "name": "Linkway",
  "description": "Send pages and links to the Linkway desktop picker or routing rules.",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": { "default_title": "Open in Linkway" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["contextMenus", "activeTab"],
  "commands": {
    "open-page": {
      "suggested_key": { "default": "Alt+Shift+L", "mac": "Alt+Shift+L" },
      "description": "Open page in Linkway"
    }
  }
}
